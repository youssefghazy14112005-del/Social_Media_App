NODE_ENV=development
PORT=9000
DB_URI=mongodb://127.0.0.1:27017/social_app
REDIS_URI=redis://127.0.0.1:6379
APP_EMAIL=your_gmail@gmail.com
APP_PASSWORD=your_google_app_password
ENC_KEY=0123456789abcdef0123456789abcdef
IV_LENGTH=16
ACCESS_USER_TOKEN_SIGNATURE=replace_with_a_long_random_secret
ACCESS_ADMIN_TOKEN_SIGNATURE=replace_with_a_long_random_secret
REFRESH_USER_TOKEN_SIGNATURE=replace_with_a_long_random_secret
REFRESH_ADMIN_TOKEN_SIGNATURE=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRES_IN=1800
REFRESH_TOKEN_EXPIRES_IN=31536000
WEB_CLIENT_IDS=your_google_web_client_id.apps.googleusercontent.com
ORIGINS=http://localhost:5173
FACEBOOK=
INSTAGRAM=
TWITTER=
